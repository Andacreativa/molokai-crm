generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── FATTURE ────────────────────────────────────────────────

model Cliente {
  id          Int       @id @default(autoincrement())
  nome        String
  cognome     String?
  email       String?
  telefono    String?
  dni         String?
  partitaIva  String?
  via         String?
  cap         String?
  citta       String?
  provincia   String?
  paese       String?   @default("Spagna")
  iban        String?
  note        String?
  tipo        String    @default("privato") // privato | azienda
  tipoImposta String    @default("IVA 21%") // IVA 21% | IVA Exenta
  createdAt   DateTime  @default(now())
  fatture     Fattura[]
}

model Fattura {
  id               Int       @id @default(autoincrement())
  numero           String?
  data             DateTime?
  scadenza         DateTime?
  clienteId        Int?
  cliente          Cliente?  @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  righe            String    // JSON: [{descrizione, quantita, prezzoUnitario}]
  prezzoConIva     Boolean   @default(false) // se true, righe.prezzoUnitario è lordo (IVA inclusa)
  tipo             String    @default("fattura") // "fattura" | "proforma" | "preventivo"
  stato            String?   // null per fatture; "in_attesa"|"accettato"|"rifiutato" per proforma/preventivo
  daDocumentoOrigine String? // es. "PRO-1/2026" quando una fattura è stata creata da un proforma/preventivo
  baseImponibile   Float
  iva              Float     @default(21)
  totale           Float
  pagato           Boolean   @default(false)
  metodoPagamento  String?   // transferencia | tarjeta | bizum | efectivo
  mese             Int
  anno             Int       @default(2026)
  note             String?
  createdAt        DateTime  @default(now())
  spesa            Spesa?
}

// ─── SPESE ──────────────────────────────────────────────────

model Spesa {
  id              Int      @id @default(autoincrement())
  data            DateTime @default(now())
  fornitore       String
  categoria       String   // Scuola | Rappresentanza | Materiale Sportivo | Affitto | Utenze | Marketing | Assicurazione | Commercialista | Tasse | Altro
  descrizione     String?
  importo         Float
  ivaDeducibile   Boolean  @default(true)
  aliquotaIva     Float    @default(21)
  ivaRecuperabile Float    @default(0)
  mese            Int
  anno            Int      @default(2026)
  ricevutaPath    String?
  note            String?
  fatturaId       Int?     @unique
  fattura         Fattura? @relation(fields: [fatturaId], references: [id], onDelete: Cascade)
  // Documento allegato auto-creato dall'OCR (file in archivio Fornitori)
  fatturaFornitore FatturaFornitore?
  createdAt       DateTime @default(now())
}

model SpesaFissa {
  id            Int      @id @default(autoincrement())
  tipo          String
  categoria     String?
  cadenza       String   // mensile | annuale | trimestrale
  dataPagamento String
  costo         Float    @default(0)
  costoMensile  Float    @default(0)
  ordine        Int      @default(0)
  attiva        Boolean  @default(true)
  note          String?
  createdAt     DateTime @default(now())
}

// ─── CLUB (SOCI + BUONI) ────────────────────────────────────

model Socio {
  id                     Int               @id @default(autoincrement())
  nome                   String
  cognome                String?
  dni                    String?
  cellulare              String?
  email                  String?
  piano                  String            // PLAN VARADA | PLAN MATERIAL | ANNUALE | ALTRO
  pianoDescrizione       String?           // usato quando piano = "ALTRO"
  prezzoPiano            Float
  pagamento              String            @default("MENSILE") // MENSILE | ANNUALE
  iban                   String?
  stato                  String            @default("ATTIVO") // ATTIVO | SOSPESO | CANCELLATO
  matricola              String?
  matricolaImporto       Float             @default(50)
  matricolaGratuita      Boolean           @default(false)
  matricolaPagata        Boolean           @default(false)
  matricolaMesePagamento String?
  matricolaFontePagamento String?          @default("Recibo") // Recibo | TPV | Contanti | Bonifico
  note                   String?
  createdAt              DateTime          @default(now())
  pagamentiMensili       PagamentoSocio[]
  buoni                  Buono[]
}

model PagamentoSocio {
  id              Int      @id @default(autoincrement())
  socioId         Int
  socio           Socio    @relation(fields: [socioId], references: [id], onDelete: Cascade)
  anno            Int
  mese            Int      // 1-12
  pagato          Boolean  @default(false)
  importo         Float?
  data            DateTime?
  fontePagamento  String?  @default("Recibo") // Recibo | TPV | Contanti | Bonifico
  createdAt       DateTime @default(now())

  @@unique([socioId, anno, mese])
}

model Buono {
  id             Int      @id @default(autoincrement())
  nome           String
  cognome        String?
  cellulare      String?
  email          String?
  socioId        Int?
  socio          Socio?   @relation(fields: [socioId], references: [id], onDelete: SetNull)
  tipoBuono      String   // BONO CLASE | PACK 4 SUP | PACK 8 SUP | CUSTOM
  prezzoBuono    Float
  pagato         Boolean  @default(false)
  mesePagamento  String?
  stato          String   @default("Attivo") // Attivo | Usato | Scaduto
  sessioniTotali Int?
  sessioniUsate  Int      @default(0)
  note           String?
  createdAt      DateTime @default(now())
}

// ─── PRENOTAZIONI ───────────────────────────────────────────

model PrenotazioneFareHarbor {
  id       Int   @id @default(autoincrement())
  anno     Int   @default(2026)
  mese     Int
  sett1    Float @default(0)
  sett2    Float @default(0)
  sett3    Float @default(0)
  sett4    Float @default(0)
  totale   Float @default(0)

  @@unique([anno, mese])
}

model FareHarborConfig {
  id            Int      @id @default(autoincrement())
  anno          Int      @unique
  refundReserve Float    @default(0)
  updatedAt     DateTime @updatedAt
}

// Versione per-data di FareHarbor (modello giornaliero, sostituisce
// gradualmente il precedente con sett1-4). Usata da bilancio/dashboard.
model IncassoFareHarbor {
  id        Int      @id @default(autoincrement())
  data      DateTime @unique
  mese      Int
  anno      Int      @default(2026)
  importo   Float    @default(0) // legacy/compat — non più usato (sostituito da netto)
  netto     Float    @default(0) // net_payout_amount dal CSV — valore usato in bilancio
  fee       Float    @default(0) // processing_fee_amount dal CSV (sempre positivo)
  lordo     Float    @default(0) // gross_amount dal CSV
  note      String?
  createdAt DateTime @default(now())
}

model PrenotazioneStripe {
  id           Int   @id @default(autoincrement())
  anno         Int   @default(2026)
  mese         Int
  lordo        Float @default(0)
  commissioni  Float @default(0)
  rimborsi     Float @default(0)
  netto        Float @default(0)

  @@unique([anno, mese])
}

model PrenotazioneGetYourGuide {
  id           Int   @id @default(autoincrement())
  anno         Int   @default(2026)
  mese         Int
  lordo        Float @default(0)
  commissioni  Float @default(0)
  netto        Float @default(0)

  @@unique([anno, mese])
}

model PagamentoInScuola {
  id            Int      @id @default(autoincrement())
  data          DateTime @unique
  mese          Int
  anno          Int      @default(2026)
  totaleGiorno  Float    @default(0)  // SALE dal CSV
  totVendite    Float    @default(0)  // TOTALSALES dal CSV
  rimborsi      Float    @default(0)  // REFUND dal CSV
  note          String?
  createdAt     DateTime @default(now())
}

model IncassoContanti {
  id          Int      @id @default(autoincrement())
  data        DateTime
  mese        Int
  anno        Int      @default(2026)
  importo     Float
  descrizione String?
  createdAt   DateTime @default(now())
}

// ─── GRUPPI ─────────────────────────────────────────────────

model Gruppo {
  id            Int       @id @default(autoincrement())
  nome          String    // es: Colegio La Salle Barceloneta
  tipo          String    @default("scuola") // scuola | azienda | altro
  contatto      String?
  email         String?
  telefono      String?
  prezzoPP      Float?    // prezzo/persona concordato; pre-compila nuove sessioni
  prezziScaglioni Json?   // array [{da, a, prezzo}] per pricing dinamico per N partecipanti
  note          String?
  createdAt     DateTime  @default(now())
  sessioni      SessioneGruppo[]
}

model SessioneGruppo {
  id             Int      @id @default(autoincrement())
  gruppoId       Int
  gruppo         Gruppo   @relation(fields: [gruppoId], references: [id], onDelete: Cascade)
  data           DateTime
  mese           Int
  anno           Int      @default(2026)
  partecipanti   Int
  prezzoPP       Float
  totale         Float    // calcolato: partecipanti * prezzoPP
  incassato      Boolean  @default(false)
  metodoPagamento String? @default("Transferencia") // Transferencia | Tarjeta | Efectivo
  note           String?
  createdAt      DateTime @default(now())
}

// ─── COLLABORATORI ──────────────────────────────────────────

model Collaboratore {
  id          Int                      @id @default(autoincrement())
  nome        String
  cognome     String?
  dni         String?
  cellulare   String?
  email       String?
  iban        String?
  ruolo       String                   // Istruttore Surf | Istruttore SUP | Insegnante Yoga | Fotografo | Receptionist | Altro
  note        String?
  attivo      Boolean                  @default(true)
  tariffe     TariffaCollaboratore[]
  sessioni    SessioneCollaboratore[]
  pagamenti   PagamentoCollaboratore[]
  anticipi    AnticipoColl[]
  createdAt   DateTime                 @default(now())
}

model TariffaCollaboratore {
  id               Int           @id @default(autoincrement())
  collaboratoreId  Int
  collaboratore    Collaboratore @relation(fields: [collaboratoreId], references: [id], onDelete: Cascade)
  tipoAttivita     String        // Classe Gruppo | Classe Singola | Sessione Yoga | Giornata | Altro
  tariffaOraria    Float
  createdAt        DateTime      @default(now())

  @@unique([collaboratoreId, tipoAttivita])
}

model SessioneCollaboratore {
  id               Int           @id @default(autoincrement())
  collaboratoreId  Int
  collaboratore    Collaboratore @relation(fields: [collaboratoreId], references: [id], onDelete: Cascade)
  data             DateTime
  mese             Int
  anno             Int           @default(2026)
  tipoAttivita     String
  ore              Float
  costo            Float         // ore * tariffa
  note             String?
  createdAt        DateTime      @default(now())
}

model PagamentoCollaboratore {
  id               Int           @id @default(autoincrement())
  collaboratoreId  Int
  collaboratore    Collaboratore @relation(fields: [collaboratoreId], references: [id], onDelete: Cascade)
  anno             Int
  mese             Int
  dovuto           Float
  pagato           Float         @default(0)
  data             DateTime?
  note             String?
  createdAt        DateTime      @default(now())

  @@unique([collaboratoreId, anno, mese])
}

model AnticipoColl {
  id               Int           @id @default(autoincrement())
  collaboratoreId  Int
  collaboratore    Collaboratore @relation(fields: [collaboratoreId], references: [id], onDelete: Cascade)
  mese             String
  importo          Float
  restituito       Boolean       @default(false)
  createdAt        DateTime      @default(now())
}

// ─── DIPENDENTI ─────────────────────────────────────────────

model Dipendente {
  id               Int                    @id @default(autoincrement())
  nome             String
  cognome          String?
  ruolo            String?
  dataNascita      DateTime?
  dni              String?
  nie              String?
  via              String?
  cap              String?
  citta            String?
  provincia        String?
  paese            String?                @default("Spagna")
  telefono         String?
  email            String?
  iban             String?
  fotoPath         String?
  nettoBustaPaga   Float                  @default(0)
  irpf             Float                  @default(0)
  irpfImporto      Float                  @default(0)
  seguridadSocial  Float                  @default(0)
  createdAt        DateTime               @default(now())
  pagamenti        PagamentoDipendente[]
}

model PagamentoDipendente {
  id            Int        @id @default(autoincrement())
  dipendenteId  Int
  dipendente    Dipendente @relation(fields: [dipendenteId], references: [id], onDelete: Cascade)
  anno          Int
  mese          Int
  tipo          String     // stipendio | seguridad
  spesaId       Int?       // collegamento a Spesa creata automaticamente al toggle
  createdAt     DateTime   @default(now())

  @@unique([dipendenteId, anno, mese, tipo])
}

// ─── FORNITORI ─────────────────────────────────────────────

model Fornitore {
  id          Int                @id @default(autoincrement())
  nome        String
  paese       String             @default("Spagna")
  email       String?
  telefono    String?
  partitaIva  String?
  via         String?
  cap         String?
  citta       String?
  provincia   String?
  note        String?
  createdAt   DateTime           @default(now())
  fattureFile FatturaFornitore[]
}

model FatturaFornitore {
  id           Int        @id @default(autoincrement())
  fileName     String
  filePath     String?
  fileData     String?    @db.Text
  fileMimeType String?
  fornitoreId  Int?
  fornitore    Fornitore? @relation(fields: [fornitoreId], references: [id], onDelete: SetNull)
  // Spesa di origine se la fattura è stata generata via OCR (1:1 opzionale)
  spesaId      Int?       @unique
  spesa        Spesa?     @relation(fields: [spesaId], references: [id], onDelete: Cascade)
  mese         Int
  anno         Int
  importo      Float      @default(0)
  dataFattura  DateTime?
  createdAt    DateTime   @default(now())
}

// ─── INVENTARIO ─────────────────────────────────────────────

model CategoriaInventario {
  id        Int              @id @default(autoincrement())
  nome      String           @unique
  ordine    Int              @default(0)
  createdAt DateTime         @default(now())
  items     InventarioItem[]
}

model InventarioItem {
  id            Int                 @id @default(autoincrement())
  categoriaId   Int
  categoria     CategoriaInventario @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  marca         String?
  modello       String?
  taglia        String?
  lunghezza     String?
  volume        String?
  numeroSerie   String?
  colore        String?
  quantita      Int                 @default(1)
  stato         String              @default("Nuovo")
  note          String?
  dataAcquisto  DateTime?
  costoAcquisto Float?
  createdAt     DateTime            @default(now())
}

// ─── ALTRI INGRESSI ─────────────────────────────────────────

model AltroIngresso {
  id          Int       @id @default(autoincrement())
  fonte       String
  descrizione String?
  mese        Int
  anno        Int       @default(2026)
  importo     Float
  incassato   Boolean   @default(false)
  dataIncasso DateTime?
  createdAt   DateTime  @default(now())
}

// ─── PRODOTTI ───────────────────────────────────────────────

model Prodotto {
  id            Int                @id @default(autoincrement())
  nome          String
  prezzoVendita Float
  feePerc       Float?
  feeFissa      Float?
  attivo        Boolean            @default(true)
  categoria     String             @default("singolo") // singolo | pack
  ordine        Int                @default(0) // posizione drag&drop nel catalogo
  createdAt     DateTime           @default(now())
  vendite       VenditaProdotto[]
  varianti      ProdottoVariante[]
  costi         CostoProdotto[]
}

model CostoProdotto {
  id         Int      @id @default(autoincrement())
  prodottoId Int
  prodotto   Prodotto @relation(fields: [prodottoId], references: [id], onDelete: Cascade)
  nome       String
  tipo       String   // "fisso" | "percentuale"
  valore     Float
  createdAt  DateTime @default(now())
}

model ProdottoVariante {
  id            Int      @id @default(autoincrement())
  prodottoId    Int
  prodotto      Prodotto @relation(fields: [prodottoId], references: [id], onDelete: Cascade)
  nome          String
  prezzoVendita Float
  ordine        Int      @default(0)
  createdAt     DateTime @default(now())
  vendite       VenditaProdotto[]
}

model VenditaProdotto {
  id             Int               @id @default(autoincrement())
  prodottoId     Int
  prodotto       Prodotto          @relation(fields: [prodottoId], references: [id])
  varianteId     Int?
  variante       ProdottoVariante? @relation(fields: [varianteId], references: [id], onDelete: SetNull)
  quantita       Int               @default(1)
  prezzoUnitario Float
  data           DateTime          @default(now())
  canale         String?
  note           String?
  createdAt      DateTime          @default(now())
}
